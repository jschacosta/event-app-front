{
  "expo": {
    "name": "Bora",
    "slug": "rio-eventos-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.boraapp.app",
      "usesAppleSignIn": true,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#64209A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.boraapp.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#64209A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bora usa tus fotos para tu perfil."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#64209A",
          "defaultChannel": "avisos"
        }
      ],
      "expo-background-task",
      "expo-build-properties",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bora usa tu ubicación para mostrarte los eventos que tienes cerca.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Bora agrega a tu calendario los eventos que eliges.",
          "calendarPermission": "Bora agrega a tu calendario los eventos que eliges.",
          "remindersPermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d39085d-8fc8-4bf8-81e4-bd4a62244331"
      }
    },
    "owner": "johann.schwarze",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5d39085d-8fc8-4bf8-81e4-bd4a62244331"
    }
  }
}
